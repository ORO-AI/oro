FROM python:3.10-slim

# Copy JDK 21 from eclipse-temurin (handles multi-arch automatically)
ENV JAVA_HOME=/opt/java/openjdk
COPY --from=eclipse-temurin:21-jdk $JAVA_HOME $JAVA_HOME
ENV PATH="${JAVA_HOME}/bin:${PATH}"

WORKDIR /app

# Install Python dependencies
COPY docker/search-server/requirements.txt .
RUN pip install --no-cache-dir --no-deps pyserini==1.0.0 && \
    pip install --no-cache-dir -r requirements.txt

# Pyserini's package initializers eagerly import dense-search implementations,
# pulling in Torch, CUDA, Transformers, ONNX, and OpenAI. This image uses only
# the pinned Lucene BM25 classes, so remove those eager imports and verify the
# exact sparse entry point before adding the index.
COPY docker/search-server/patch_pyserini.py /tmp/patch_pyserini.py
RUN python /tmp/patch_pyserini.py && \
    rm /tmp/patch_pyserini.py && \
    python -c 'from pyserini.search.lucene import LuceneSearcher; print(LuceneSearcher.__name__)'

# Bake the Lucene identity manifest alongside the index. `src/search_engine/
# server.py` reads `/app/lucene_manifest.json` at import to populate
# SEARCH_IDENTITY; that identity flows into every `/health` response and the
# publish pipeline's identity guardrail (`.github/workflows/publish-images.yml`)
# refuses to promote an image whose /health reports None here. A base that
# ships the index but forgets the manifest silently publishes an unhealthy
# image (ORO-2244 root cause).
COPY lucene_manifest.json /app/lucene_manifest.json

# Keep the large archive compressed in the build context. ADD expands it into
# one image layer, avoiding a second host copy of the full Lucene index.
# If `index.tar.gz` also carries a top-level `lucene_manifest.json`, ADD's
# extraction wins over the COPY above — that is the intended behavior when
# the tarball is authoritative (e.g. built by the pack pipeline).
ADD index.tar.gz /app/

# Validate every expanded index file before this base image can be published.
RUN test -d /app/index && \
    ln -s /app/index /app/indexes && \
    mkdir /app/sidecar && \
    python - <<'PY'
import hashlib
import json
from pathlib import Path

manifest = json.loads(Path("lucene_manifest.json").read_text())
expected = manifest["files"]
actual = {
    path.name
    for path in Path("index").iterdir()
    if path.is_file() and not path.is_symlink()
}
if actual != set(expected):
    raise SystemExit("Lucene index file set does not match its manifest")
for name, identity in expected.items():
    path = Path("index", name)
    if path.is_symlink() or not path.is_file():
        raise SystemExit(f"Lucene index member is not a regular file: {name}")
    if path.stat().st_size != identity["size_bytes"]:
        raise SystemExit(f"Lucene index size mismatch: {name}")
    digest = hashlib.sha256()
    with path.open("rb") as index_file:
        for chunk in iter(lambda: index_file.read(1024 * 1024), b""):
            digest.update(chunk)
    if digest.hexdigest() != identity["sha256"]:
        raise SystemExit(f"Lucene index digest mismatch: {name}")
PY

# A sealed index records the JDK used to build it. Refuse a later rebuild if
# the selected Temurin tag has moved to a different Java release.
RUN python - <<'PY'
import json
import subprocess

with open("lucene_manifest.json") as manifest_file:
    expected = json.load(manifest_file)["java_version"]
actual = subprocess.check_output(
    ["java", "-version"], stderr=subprocess.STDOUT, text=True
).splitlines()[0]
if actual != expected:
    raise SystemExit(f"Lucene index requires {expected!r}, image provides {actual!r}")
PY

# The empty sidecar selects the server's existing decode fallback. Pure
# /internal/bm25 does not use this sidecar.

# ORO Environment Configuration
# Copy to .env and fill in required values:
#   cp .env.example .env

# === MINER LOCAL TESTING ===

# Set an inference provider's API key for testing agents locally.
# The test runner picks whichever key is set; if both are set, use
# INFERENCE_PROVIDER below to choose. Only needed for:
#   docker compose run test --agent-file agent.py
# Not needed for validators (miner tokens are forwarded automatically).

# Chutes API key. Get one at: https://chutes.ai/
CHUTES_API_KEY=

# OpenRouter API key. Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional override when both keys are set. One of: chutes, openrouter
INFERENCE_PROVIDER=

# Optional model override for the generated-environment reference agent. Custom
# agents choose their own Backend-allowlisted model or models in agent code.
SANDBOX_MODEL=deepseek-ai/DeepSeek-V3.2-TEE

# Generated local testing uses the same stable search image as validators and
# verifies its index identity against the bundled pack before agent execution.
# LOCAL_SEARCH_SERVER_IMAGE overrides that image for development builds.

# === OPTIONAL (defaults shown) ===

# JVM memory for search server (increase if you have more RAM)
JAVA_OPTS=-Xmx8g -Xms4g

# === VALIDATOR ONLY ===

# Bittensor wallet (must be registered on subnet)
WALLET_NAME=default
WALLET_HOTKEY=default
NETUID=15
SUBTENSOR_NETWORK=finney  # Use "test" for testnet (NOT "testnet")

# Optional: point at a private subtensor RPC to avoid the shared
# foundation-finney endpoint (which will 429 you off the network under any
# real load — see async-substrate-interface 2.x reconnect behavior). When
# set, wins over SUBTENSOR_NETWORK. Leave blank to use the network default.
#   SUBTENSOR_CHAIN_ENDPOINT=wss://my-node.example.com:443

# Backend API
BACKEND_URL=https://api.oroagents.com

# Auto-update (Watchtower)
WATCHTOWER_TOKEN=oro-watchtower-token
# ORO_AUTO_UPDATE=true  # Set to false to disable
